# Backend environment placeholders only. NEVER put real credentials or secrets in this file.
# Copy to backend/.env for local development and fill in local values if needed.
APP_NAME=saas-admin-backend
APP_ENV=development
API_V1_PREFIX=/api/v1
DEBUG=false
# Comma-separated allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=true

# Phase 1: database URL (SQLAlchemy). SQLite default requires no server; Termux-safe
# PostgreSQL testing uses the pure-Python pg8000 driver. NEVER put real credentials here.
# SQLite (local dev):     DATABASE_URL=sqlite:///./dev.db
# PostgreSQL (via pg8000): DATABASE_URL=postgresql+pg8000://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# B1 (approved, config-only in this batch): JWT authentication settings.
# Required for application startup/config validation. Use strong, environment-specific values.
# NEVER commit real secrets. CI/tests must use non-production, test-only values.
# AUTH_JWT_SECRET must be high-entropy (minimum 32 UTF-8 bytes).
AUTH_JWT_SECRET=CHANGE_ME_TO_A_STRONG_NON_PRODUCTION_SECRET_VALUE
AUTH_JWT_ISSUER=https://auth.example.invalid
AUTH_JWT_AUDIENCE=northstar-api
# Access token lifetime in minutes (approved: 15).
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Phase 2: models/migrations; later B1 batches: auth endpoints/security primitives/bootstrap.
